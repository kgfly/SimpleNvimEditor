<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SimpleNvimEditor"
           Manufacturer="kgfly"
           Version="$(var.Version)"
           UpgradeCode="8F3B1C42-7A5E-4D91-9E2B-6C4A1D8F3E70">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="SimpleNvimEditor" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="PathEntry" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SimpleNvimEditor" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Source="$(var.BinaryDir)\simplenvim.exe" KeyPath="yes" />
      </Component>
      <Component Id="License">
        <File Source="$(var.BinaryDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="Readme">
        <File Source="$(var.BinaryDir)\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Component Id="PathEntry" Directory="INSTALLFOLDER"
               Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                   Permanent="no" Part="last" Action="set" System="no" />
    </Component>
  </Fragment>
</Wix>
